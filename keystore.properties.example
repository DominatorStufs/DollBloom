# Local release signing. You almost certainly do not want to fill this in by
# hand — the signing key for this project is stored encrypted in `signing/`, and
# one command unseals both this file and the keystore it points at:
#
#   DOLLBLOOM_SIGNING_PASSPHRASE='…' \
#     python3 signing/dollbloom_signing.py --passphrase-env DOLLBLOOM_SIGNING_PASSPHRASE \
#     unseal --out-dir .
#
# That writes `dollbloom-release.jks` and a filled-in `keystore.properties`
# here. Delete both when you are finished; they are gitignored, but they are
# still the private key sitting in the clear.
#
# See signing/README.md. Both this file's name and the keystore's are gitignored
# — never commit either, and never commit a key you generated by hand.
#
# The exception is a key of your own, for a fork with a different application ID
# that will never share an update channel with DollBloom. Generate one the usual
# way and keep it out of the repository exactly as above:
#
#   keytool -genkeypair -v -keystore dollbloom-release.jks \
#       -storetype JKS -keyalg RSA -keysize 4096 -validity 10950 \
#       -alias dollbloom
#
# In CI, nothing here is used: the release workflow unseals the repository's own
# key and writes this file itself.

storeFile=dollbloom-release.jks
storeType=JKS
storePassword=
keyAlias=dollbloom
keyPassword=
