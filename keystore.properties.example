# Optional local release-signing config template. Copy this file to the
# root-level keystore.properties and fill in the passwords. Both keystore files
# and keystore.properties are gitignored — never commit private key material.
#
# Generate a local keystore once from the project root with alias dollbloom:
#
#   keytool -genkeypair -v -keystore dollbloom-release.jks \
#       -storetype JKS -keyalg RSA -keysize 2048 -validity 10000 \
#       -alias dollbloom
#
# For GitHub Actions, store the matching values as repository secrets; the
# workflow creates keystore.properties at build time.

storeFile=dollbloom-release.jks
storeType=JKS
storePassword=
keyAlias=dollbloom
keyPassword=
